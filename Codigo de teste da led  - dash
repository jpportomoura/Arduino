void lerDashboard() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    String url = "https://api.tago.io/data?variable=led_status&qty=1";

    http.begin(url);
    http.addHeader("Device-Token", token);

    int httpResponseCode = http.GET();

    if (httpResponseCode > 0) {
      String payload = http.getString();
      Serial.println("Resposta GET: " + payload);

      StaticJsonDocument<1024> doc;  // Aumenta o buffer para evitar overflow
      DeserializationError error = deserializeJson(doc, payload);

      if (!error) {
        JsonArray result = doc["result"];
        if (!result.isNull() && result.size() > 0) {
          const char* value = result[0]["value"];

          if (String(value) == "on") {
            controleManual = true;
            ledStatus = true;
          } else if (String(value) == "off") {
            controleManual = true;
            ledStatus = false;
          } else if (String(value) == "auto") {
            controleManual = false;
          }
        } else {
          Serial.println("Nenhum dado encontrado no campo 'result'.");
        }
      } else {
        Serial.print("Erro na leitura do JSON: ");
        Serial.println(error.c_str());
      }
    } else {
      Serial.print("Erro GET: ");
      Serial.println(httpResponseCode);
    }
    http.end();
  }
}

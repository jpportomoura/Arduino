#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <DHT11.h>

const char* ssid = "UNIFESO";   //nome do wifi
const char* password = "";   //senha do wifi

String token = "b676476d-554a-45b1-9ace-b04e399d2db8";    //código do divice do tago

//Definição dos pinos
#define led1 16
#define led2 17
#define led3 18
#define led4 19
#define LDR 4
#define releVent 23
DHT11 dht11(21);  //pino do sensor de temperatura 

bool controleManual = false;
bool ledStatus = false;
int faseCrescimento = 0;
float temperaturaIdeal = 0.0;
float umidadeIdeal = 0.0;
int temperaturaAtual = 0;
int umidadeAtual = 0;

struct DadosTU {  //essa estrutura serve como um pacote que guarda dois valores 
  int temperatura;
  int umidade;
};

//CONFIGURAÇÕES DO SENSOR DE TEMPERATURA E UMIDADE
DadosTU sensorTU() {  //é uma função que retorna dados do tipo DadosTU(entrega o pacote)
  DadosTU dados; //cria uma variavel do tipo de dados

  int resultado = dht11.readTemperatureHumidity(dados.temperatura, dados.umidade);  //preenche diretamente ai dentro

   if (resultado == 0) {
    Serial.print("Temperatura: ");
    Serial.print(dados.temperatura);
    Serial.print(" °C\tUmidade: ");
    Serial.print(dados.umidade);
    Serial.println(" %");
  } else {
    Serial.println(DHT11::getErrorString(resultado));
    dados.temperatura = -1; //Valores apenas para verificar erros 
    dados.umidade = -1;   //Valores apenas para verificar erros
  }

  return dados; 
}

void setup() {
  Serial.begin(9600);
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);
  pinMode(LDR, INPUT);
  pinMode(releVent, OUTPUT);
  digitalWrite(releVent, LOW);
}

void loop() {
  verificaWifi(); //começa o programa verificando a CONEXÃO
  lerDashboard(); //Lê os comandos do dashboard
  iluminacao();
  DadosTU resultadoTU = sensorTU();  //chama a função e retorna uma struct com dois valores resultadoTU.temperatura, resultadoTU.umidade
  temperaturaAtual = resultadoTU.temperatura;
  umidadeAtual = resultadoTU.umidade;
  ajustarCondicoes();  //Condições ideais
  controlarVentoinha(temperaturaAtual, umidadeAtual);  
  medirRacao();
  enviaDados();
  delay(5000);
}

//FUNÇÃO PARA VERIFICAR A CONEXÃO COM WIFI
void verificaWifi() {
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Já está conectado ao Wi-Fi.");
    return;
  }

  WiFi.begin(ssid, password);
  Serial.println("Conectando ao Wi-Fi...");

  //espera até conectar
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("Wi-Fi conectado!");
  Serial.print("Endereço de IP: ");
  Serial.println(WiFi.localIP());
}

//LÊ OS COMANDOS DO DASHBOARD PARA EXECUTA-LOS
void lerDashboard() {
  //CONFIGURAÇÃO DOS CONTROLES DAS LUZES
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http; //é um objeto que permite fazer requisições HTTP por GET POST, etc.
    String url = "https://api.tago.io/data?variable=led_status&qty=1"; //pega o valor da variavel led_status
    
    http.begin(url); //inicia a conexão
    http.addHeader("Device-Token", token); //adiciona um cabeçalho com o token que é necessário para a autenticação

    int httpResponseCode = http.GET(); // faz a requisição HTTP GET para a URL e retorna um codigo de resposta tipo: 200 se deu certo, 404 se nn achou, 500 se erro no servidor e etc.

    if (httpResponseCode > 0) {  //esta verificando se a requisição houve uma resposta sem erro
      String payload = http.getString(); //pega a resposta da API em formato JSON e armasena na variavel payload
      Serial.println("Resposta GET: " + payload); //imprime a resposta no monitor serial para a depuração

      StaticJsonDocument<512> doc; //cria um doc JSON na memória com capacidade para ate 512 bytes para armazenar os dados da resposta
      DeserializationError error = deserializeJson(doc, payload);  //faz o parce do JSON para uma que o codigo pode acessar

      if (!error) { //verifica se houve erro no JSON
        const char* value = doc[0]["value"]; //acessa o valor dentro do JSON - começando pelo primeiro elemento - value = pega o valor da variavel led_status (pode ser on, off, auto)

        if (String(value) == "on") { //se for on executa o bloco
          controleManual = true;  //ativa o modo manual
          ledStatus = true;  //e define que os leds devem estar ligados
        } else if (String(value) == "off") {
          controleManual = true; //modo manual ativado
          ledStatus = false;  //define os leds devem estar desligados
        } else if (String(value) == "auto") {
          controleManual = false;
        }
      } else {
        Serial.print("Erro GET: ");  //mostra os possiveis erros
        Serial.println(httpResponseCode);
      }
    }
    http.end();  //finaliza a conexão HTTP liberando os recursos da memória 
  }

  //CONFIGURAÇÃO DAS SEMANAS DE VIDA
  if (WiFi.status() == WL_CONNECTED) {  //MESMAS COISAS DO DE CIMA
    HTTPClient http;
    String url = "https://api.tago.io/data?variable=fase_crescimento&qty=1";

    http.begin(url);
    http.addHeader("Device-Token", token);

    int httpResponseCode = http.GET(); // Adicionei a requisição aqui

    if (httpResponseCode > 0) {
      String payload = http.getString();
      Serial.println("Resposta GET fase: " + payload);
      StaticJsonDocument<512> doc;
      DeserializationError error = deserializeJson(doc, payload);

      if (!error) {
        const char* value = doc[0]["value"];

        if (String(value) == "1semana") {  //Atualiza a fase de crescimento com base no botão pressionado
          faseCrescimento = 0;
        } else if (String(value) == "2semana") {
          faseCrescimento = 1;
        } else if (String(value) == "apos21dias") {
          faseCrescimento = 2; 
        }
      }
    } else {
      Serial.print("Erro GET fase: ");
      Serial.println(httpResponseCode);
    }
    http.end();
  }
}

void ajustarCondicoes() {
  switch (faseCrescimento) {
    case 0: //1 semana
    temperaturaIdeal = 32.0;
    umidadeIdeal = 65.0;
    break;
    case 1:  //2 semanas
    temperaturaIdeal = 28.5;
    umidadeIdeal = 65.0;
    break;
    case 2: 
    temperaturaIdeal = 24.0;
    umidadeIdeal = 60.0;
    break;
  }
}

//CONTROLE DA VENTOINHA
void controlarVentoinha(int temperaturaAtual, int umidadeAtual) {
  if (temperaturaAtual > temperaturaIdeal || umidadeAtual > umidadeIdeal) {
    digitalWrite(releVent, HIGH);
  } else {
    digitalWrite(releVent, LOW);
  }  
}


//FUNÇÃO DE CONFIGURAÇÃO GERAL DAS LUZES
void iluminacao() {
  int valorLDR = analogRead(LDR);
  Serial.print("LDR = ");
  Serial.print(valorLDR);

  //Abaixo disso ele vai ler noite 
  int limiteLuz = 2500;

  if(!controleManual) {
    if (valorLDR <= limiteLuz){   //configuração do controle automático
      ligarLEDs();
    } else {
      desligarLEDs();
    }
  } else {
    if (ledStatus) {
      ligarLEDs();
    } else {
      desligarLEDs();
    }
  }
}

//FUNÇÕES AUXILIARES DA FUNÇÃO DE ILUMINAÇÃO
void ligarLEDs() {
  digitalWrite(led1, HIGH);
  digitalWrite(led2, HIGH);
  digitalWrite(led3, HIGH);
  digitalWrite(led4, HIGH);
}

void desligarLEDs() {
  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);
  digitalWrite(led3, LOW);
  digitalWrite(led4, LOW);
}

//CONFIGURAÇÃO DOS ENVIOS DE DADOS
void enviaDados() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;    //mesma coisa la de cima 
    http.begin("https://api.tago.io/data");
    http.addHeader("Content-Type", "application/json");
    http.addHeader("Device-Token", token);

    StaticJsonDocument<512> doc;
    JsonArray data = doc.to<JsonArray>();  //esse array vai conter os objetos que serão enviados

    //OPCIONAL
    /*JsonObject ldr = data.createNestedObject();
    ldr["variable"] = "ldr";
    ldr["value"] = valorLDR;**/

    JsonObject temp = data.createNestedObject();
    temp["variable"] = "temperatura";
    temp["value"] = temperaturaAtual;
    temp["unit"] = "C";

    JsonObject hum = data.createNestedObject();
    hum["variable"] = "umidade";
    hum["value"] = umidadeAtual;
    hum["unit"] = "%";

    JsonObject lightStatus = data.createNestedObject();
    lightStatus["variable"] = "light_status";
    lightStatus["value"] = ledStatus ? "on" : "off";

    //ESPAÇO PARA A DO SENSOR DE DISTANCIA

    String json;
    serializeJson(doc, json);

    int httpResponseCode = http.POST(json);

    if (httpResponseCode > 0) {
      String response = http.getString();
      Serial.println(response);
    } else {
      Serial.print("Erro no envio: ");
      Serial.println(httpResponseCode);
    }
    http.end();
  }
}
